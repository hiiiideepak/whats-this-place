# Copy to .env in the repo root. The API reads this file and apps/api/.env.

# HTTP port for the Nest API.
PORT=3000

# Postgres + PostGIS. Host port 5433 avoids a local Postgres already bound to 5432.
DATABASE_URL=postgresql://around:around@localhost:5433/around

# Redis. Matches docker-compose.yml defaults.
REDIS_URL=redis://localhost:6379

# Nominatim usage policy requires an identifying User-Agent.
# example.com addresses are rejected. Use a real contact or this project URL.
# https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Around/0.1 (https://github.com/hiiiideepak/whats-this-place)

# OSM Overpass endpoint for essentials and famous places.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Wikipedia and Wikidata. English is the default; the lookup also follows interlanguage links.
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php

# Google Places API (New). Required for eat, stay, and coffee.
# Create a key with Places API (New) enabled. Leave blank until that step.
GOOGLE_PLACES_API_KEY=

# Anthropic. Used only to summarize Wikipedia/Wikidata text that we already fetched.
# If unset, the API returns a short excerpt of that source text and never invents an origin.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Requests per minute per X-Device-Id (falls back to client IP).
RATE_LIMIT_PER_MINUTE=60

# Mobile app. Use your machine's LAN IP instead of localhost on a physical device.
# Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
